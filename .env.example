# Copy to .env and fill in real values. Never commit .env.
# Placeholders only. Development values must never point at production data.

# ---- Server (apps/api): never shipped inside the app ----
# Every variable here is validated at startup (Phase 3), so a missing one fails fast.
NODE_ENV=development
API_URL=http://localhost:3000

DATABASE_URL=postgresql://user:password@localhost:5432/app_dev

# Generate a different one per environment: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# Lowest app version allowed to call the API; older versions see the update screen
MIN_SUPPORTED_APP_VERSION=1.0.0

SENTRY_DSN=

# Uncomment only if SPEC.md needs payments, with TEST keys in development
# PAYMENTS_SECRET_KEY=sk_test_replace_me
# PAYMENTS_WEBHOOK_SECRET=whsec_replace_me

# ---- App (apps/mobile): PUBLIC ----
# Everything below is compiled into the app, and anyone who installs it can read it.
# Never put a secret here. Phase 3 renames these with the stack's public prefix
# (EXPO_PUBLIC_ for Expo; Flutter reads them through --dart-define).
APP_PUBLIC_API_URL=http://localhost:3000
APP_PUBLIC_SENTRY_DSN=

# Signing keys, store API keys and push credentials never go in this file.
# They live in the build service's or CI's secret store (docs/launch-checklist.md).
